# VKE C++ formatting.
# Based on Godot Engine's .clang-format (MIT, github.com/godotengine/godot).
# Changing this file means formatting the whole code base: tools/check.ps1 -All, then clang-format -i.

BasedOnStyle: LLVM

# Indentation: tabs, 4 wide
UseTab: Always
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 8
ConstructorInitializerIndentWidth: 8
AccessModifierOffset: -4
IndentCaseLabels: true

# VKE keeps a 120-column limit
ColumnLimit: 120

# Alignment
AlignAfterOpenBracket: DontAlign
AlignEscapedNewlines: DontAlign # Aligning leads to long diffs
AlignOperands: DontAlign
AlignTrailingComments:
  Kind: Never
  OverEmptyLines: 0

# Short forms
AllowShortFunctionsOnASingleLine: Inline
AllowAllParametersOfDeclarationOnNextLine: false

# Constructors
BreakConstructorInitializers: AfterColon
PackConstructorInitializers: NextLine

# Code rewrites: braces on every control statement, no stray semicolons, const before the type
InsertBraces: true
RemoveSemicolon: true
QualifierAlignment: Left

# Braced lists get inner spaces: { 1, 2 }
Cpp11BracedListStyle: false

KeepEmptyLinesAtTheStartOfBlocks: false

# The engine's macros, so the rewrites above read declarations right.
# Reflection marks come before a declaration; VKE_COMPONENT/VKE_SCRIPT/VKE_ENUM_FLAGS stand alone, without ';'.
AttributeMacros:
  - VKE_API
  - VKE_PROPERTY
  - VKE_STRUCT
  - VKE_ENUM
StatementMacros:
  - VKE_COMPONENT
  - VKE_SCRIPT
  - VKE_ENUM_FLAGS

# Comments may have no space after // (disabled code)
SpacesInLineCommentPrefix:
  Minimum: 0
  Maximum: -1

# Includes, in groups: the file's own header, local headers, engine modules,
# windows.h (other Windows headers need it first), libraries, standard library.
IncludeBlocks: Regroup
MainIncludeChar: Any
IncludeCategories:
  - Regex: ^".*"$
    Priority: 10
  - Regex: ^<(assets|core|events|math|physics|platform|project|reflection|renderer|rhi|scene|scripting|ui|vke)/.*>$
    Priority: 20
  - Regex: ^<[Ww]indows\.h>$
    Priority: 50
  - Regex: ^<.*\.(h|hpp)>$
    Priority: 60
  - Regex: ^<.*>$
    Priority: 70

Standard: c++17
