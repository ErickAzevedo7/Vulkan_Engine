{
  "name": "vulkan-engine",
  "version": "1.0.0",
  "dependencies": [
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        "glfw-binding",
        "vulkan-binding"
      ]
    },
    "glfw3",
    "stb",
    "tinyobjloader",
    "assimp",
    "glm",
    "joltphysics",
    "vulkan",
    "vulkan-memory-allocator",
    "yaml-cpp",
    "spdlog",
    {
      "name": "tracy",
      "default-features": false,
      "features": [
        "on-demand"
      ]
    }
  ]
}
