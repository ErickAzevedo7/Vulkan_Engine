# VKE static analysis. Run through tools/check.ps1, which uses the build tree's compile_commands.json.
# Checks are opt-in: a family is enabled, then the parts that fight the engine's style are turned off.
Checks:
  - -*
  - bugprone-*
  - -bugprone-easily-swappable-parameters
  - -bugprone-narrowing-conversions
  - -bugprone-implicit-widening-of-multiplication-result
  - -bugprone-exception-escape
  - -bugprone-unchecked-optional-access
  # Vulkan's FlagBits start at {}, std::hash is specialized on purpose, and the engine's macros generate types.
  - -bugprone-invalid-enum-default-initialization
  - -bugprone-std-namespace-modification
  - -bugprone-macro-parentheses
  - -bugprone-throwing-static-initialization
  - clang-analyzer-core.*
  - clang-analyzer-cplusplus.*
  - clang-analyzer-deadcode.*
  - clang-analyzer-unix.*
  - cppcoreguidelines-slicing
  - cppcoreguidelines-virtual-class-destructor
  - cppcoreguidelines-missing-std-forward
  - cppcoreguidelines-rvalue-reference-param-not-moved
  - misc-definitions-in-headers
  - misc-misplaced-const
  - misc-redundant-expression
  - misc-static-assert
  - misc-unused-using-decls
  - misc-unused-alias-decls
  - modernize-deprecated-headers
  - modernize-make-unique
  - modernize-redundant-void-arg
  - modernize-use-bool-literals
  - modernize-use-emplace
  - modernize-use-equals-default
  - modernize-use-equals-delete
  - modernize-use-nullptr
  - modernize-use-override
  - modernize-use-using
  - performance-*
  - -performance-enum-size
  - readability-container-size-empty
  - readability-delete-null-pointer
  - readability-identifier-naming
  - readability-inconsistent-declaration-parameter-name
  - readability-misleading-indentation
  - readability-redundant-control-flow
  - readability-redundant-member-init
  - readability-redundant-smartptr-get
  - readability-redundant-string-cstr
  - readability-simplify-boolean-expr
  - readability-static-accessed-through-instance

# Only the engine's own headers; generated reflection code and vcpkg packages are left out.
HeaderFilterRegex: '.*[/\\](Engine|engine|Editor|runtime|tools)[/\\].*'
ExcludeHeaderFilterRegex: '.*[/\\](build|vcpkg_installed|\.vke)[/\\].*'

CheckOptions:
  # Types and functions: PascalCase. Namespaces are free (VKE, VKE::Scene, vke).
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  # Formats spelled like Vulkan's: R8G8B8A8_UNORM.
  readability-identifier-naming.EnumConstantIgnoredRegexp: '^[A-Z0-9]+(_[A-Z0-9]+)+$'
  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.MethodCase: CamelCase
  readability-identifier-naming.FunctionIgnoredRegexp: '^(main|WinMain|begin|end|hash|swap|operator.*)$'
  readability-identifier-naming.MethodIgnoredRegexp: '^(begin|end|operator.*)$'
  readability-identifier-naming.TemplateParameterCase: CamelCase
  # Members: m_ for private and protected, s_ for static, PascalCase for public data.
  readability-identifier-naming.PrivateMemberPrefix: m_
  readability-identifier-naming.PrivateMemberCase: CamelCase
  readability-identifier-naming.ProtectedMemberPrefix: m_
  readability-identifier-naming.ProtectedMemberCase: CamelCase
  readability-identifier-naming.PublicMemberCase: CamelCase
  readability-identifier-naming.ClassMemberPrefix: s_
  readability-identifier-naming.ClassMemberCase: CamelCase
  # Constants: k prefix in classes; namespace tokens (Colors::Accent, Icons::Box) may drop it.
  readability-identifier-naming.ClassConstantPrefix: k
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantIgnoredRegexp: '^k[A-Z][A-Za-z0-9]*$'
  # Parameters and locals: camelCase, with kName for local constants and s_Name for static ones.
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.LocalVariableCase: camelBack
  readability-identifier-naming.LocalConstantCase: camelBack
  readability-identifier-naming.LocalConstantIgnoredRegexp: '^(k|s_)[A-Z][A-Za-z0-9]*$'
  readability-identifier-naming.StaticVariableCase: camelBack
  readability-identifier-naming.StaticVariableIgnoredRegexp: '^s_[A-Z][A-Za-z0-9]*$'
  modernize-use-override.IgnoreDestructors: true
  readability-simplify-boolean-expr.SimplifyDeMorgan: false
  performance-unnecessary-value-param.AllowedTypes: '^(Handle|.*ID|Vec[234]|Mat[34]|Quat)$'
  bugprone-unused-return-value.AllowCastToVoid: true
